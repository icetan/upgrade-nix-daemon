#!/usr/bin/env bash
set -eo pipefail

export DEBUG=${DEBUG:-}
if [[ -n $DEBUG ]]; then set -x; fi

usage() {
  echo >&2 "Usage: upgrade-nix-daemon [ NIX_REF ]

Arguments:

  NIX_REF       URI referencing the nix package, defaults to store path of nix
                in current shell environment
"
  exit 1
}

main() {
  "$NIX" "${NIX_ARGS[@]}" profile list
  echo -n >&2 "Type name of profile to replace for root user (empty to not remove a profile): "
  read -r answer
  for profile in $answer; do
    if [[ -n $profile ]]; then
      "$NIX" "${NIX_ARGS[@]}" profile remove "$profile"
    fi
  done

  echo >&2 "installing nix profile"
  "$NIX" "${NIX_ARGS[@]}" profile install "$NIX_REF"

  if [[ $(id -u) != 0 ]]; then
    return 0
  fi

  echo >&2 "restarting nix-daemon"
  if command -v systemctl >/dev/null 2>&1; then
    # On Linux with systemd
    systemctl daemon-reload
    systemctl enable --now nix-daemon
    systemctl restart nix-daemon
  elif command -v launchctl >/dev/null 2>&1; then
    # On MacOS
    launchctl stop org.nixos.nix-daemon
    launchctl start org.nixos.nix-daemon
  else
    echo >&2 "Warning: Couldn't detect how to restart nix-daemon"
    echo >&2 "You will have to manually restart nix-daemon for configuration changes to take effect"
  fi
}

NIX=${NIX:-$(realpath "$(command -v nix)")}
NIX_STORE_PATH=${NIX%/bin/nix}
NIX_ARGS=(--extra-experimental-features "nix-command flakes")
UPGRADE_USER=root

while [[ -n ${1:-} ]]; do
  case $1 in
    -u) UPGRADE_USER="$2"; shift;;
    -U) UPGRADE_USER=$(whoami);;
    -*) usage;;
    *)  NIX_REF="$1";;
  esac
  shift
done

NIX_REF="${NIX_REF:-$NIX_STORE_PATH}"

if [[ $(id -u) == $(id -u "$UPGRADE_USER") ]]; then
  echo  >&2 "Upgrade nix for user $UPGRADE_USER to $NIX_STORE_PATH:"
  main
else
  BASH=$(command -v bash)
  SUDO=${SUDO:-sudo}
  $SUDO -u "$UPGRADE_USER" "$BASH" -c "NIX='$NIX' $0"' "$@"' _ "${NIX_REF[@]}"
fi
